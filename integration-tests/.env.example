# Copy to .env in this directory -- `docker compose` and the pytest fixtures
# both read it automatically. Fill in real values before running the stack.

# data-api always pulls ghcr.io/usace/cwms-data-api; this only sets the tag.
# CDA_ETL_GIT_REF is pinned to a commit on top of this release (it publishes
# location groups after projects, so they can assign locations that exist).
CDA_DATA_API_VERSION=2026.09.22-a
# cda-etl is built from this git repo/ref (subdir cda-etl). Pin the ref to a
# tag or commit SHA for reproducible runs.
CDA_ETL_GIT_URL=https://github.com/USACE/cwms-data-api.git
CDA_ETL_GIT_REF=16219ad9b9a7433bed329de4dcc222e95acb346f
CDA_PORT=7000
